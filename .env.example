# ---- AI provider ----------------------------------------------------------
# gemini  : vision + native PDF + text   (recommended primary)
# deepseek: text only — cannot read images or scanned PDFs
# mock    : canned fixtures, no network, no cost (default for tests)
LLM_PROVIDER=mock

# Optional split: cheap text model for reasoning/advice, Gemini for eyes.
# Leave blank to use LLM_PROVIDER for everything.
LLM_VISION_PROVIDER=

GEMINI_API_KEY=              # aistudio.google.com
DEEPSEEK_API_KEY=            # platform.deepseek.com

# Model IDs move. These were confirmed against Google's docs in August 2026;
# gemini-3.5-flash-lite is cheaper and weaker on Hinglish screenshots.
GEMINI_MODEL=gemini-3.6-flash
DEEPSEEK_MODEL=deepseek-chat

# ---- channels -------------------------------------------------------------
# Blank means "not set" — the app treats an empty value as absent rather than as
# a credential of zero length, so a copied .env fails with a readable message.
TELEGRAM_BOT_TOKEN=            # from @BotFather
TELEGRAM_MODE=polling          # polling (dev, no tunnel needed) | webhook (deployed)
PUBLIC_BASE_URL=               # required only in webhook mode, e.g. https://x.up.railway.app
# The webhook's secret token is derived from TELEGRAM_BOT_TOKEN — nothing to set.

# ---- storage --------------------------------------------------------------
DATABASE_URL=sqlite:///./data/arthasathi.db

# ---- scam detection thresholds -------------------------------------------
SCAM_HIGH_RISK_THRESHOLD=51
SCAM_RULE_WEIGHT=0.6
SCAM_DISAGREEMENT_DOWNGRADE=40
SCAM_MIN_RULES_ABOVE_50=2

# ---- cost + abuse control -------------------------------------------------
MAX_UPLOAD_MB=10
IMAGE_MAX_EDGE_PX=1568         # long edge before any vision call
DAILY_ANALYSES_PER_USER=20     # one user cannot burn the shared quota
MONTHLY_SPEND_CAP_INR=2000     # hard stop; checked before every call

# Rupees per million tokens, used only to decide when the cap is reached.
GEMINI_INPUT_INR_PER_MTOK=25
GEMINI_OUTPUT_INR_PER_MTOK=200
